set -euo pipefail

TMP_DIR="/tmp"

display_help() {
  echo "----------------------------------------------------------------------------"
  echo " Spine Package Script"
  echo "   Attempts to package spine from a repository checkout directory of"
  echo "   spine. If all goes well a tar.gz file will be created."
  echo "----------------------------------------------------------------------------"
  echo " Syntax:"
  echo "  ./$(basename "$0") <Version>"
  echo ""
  echo "    <Version> - Designated version for build (required)"
  echo ""
}

if [[ ! -e CMakeLists.txt ]]; then
  echo "ERROR: Your current working directory must be a Spine source checkout"
  exit 1
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  display_help
  exit 0
fi

if [[ -z "${1:-}" ]]; then
  echo ""
  echo "ERROR: Invalid syntax, missing required argument"
  echo ""
  display_help
  exit 1
fi
VERSION="$1"

echo ""
echo "----------------------------------------------------------------------------"
echo "Spine package builder"
echo "  Version: ${VERSION}"
echo "----------------------------------------------------------------------------"

if [[ -e "${TMP_DIR}/cacti-spine-${VERSION}" ]]; then
  echo "INFO: Removing previous build ${TMP_DIR}/cacti-spine-${VERSION}..."
  rm -rf "${TMP_DIR}/cacti-spine-${VERSION}" >/dev/null 2>&1 || {
    echo "ERROR: Unable to remove directory: ${TMP_DIR}/cacti-spine-${VERSION}"
    exit 1
  }
fi

if [[ -e "${TMP_DIR}/cacti-spine-${VERSION}.tar.gz" ]]; then
  rm -rf "${TMP_DIR}/cacti-spine-${VERSION}.tar.gz" >/dev/null 2>&1 || {
    echo "ERROR: Unable to remove file: ${TMP_DIR}/cacti-spine-${VERSION}.tar.gz"
    exit 1
  }
fi

mkdir -p "${TMP_DIR}/cacti-spine-${VERSION}" >/dev/null 2>&1
tar -cf - --exclude 'package' --exclude '.svn' --exclude '.travis.yml' ./* | (
  cd "${TMP_DIR}/cacti-spine-${VERSION}" || exit 1
  tar -xf -
) || {
  echo "ERROR: Unable to copy repository to ${TMP_DIR}/cacti-spine-${VERSION}"
  exit 1
}

pushd "${TMP_DIR}/cacti-spine-${VERSION}" >/dev/null || exit 1

SRC_VERSION=$(sed -n 's/^project(spine VERSION \([^ ]*\).*/\1/p' CMakeLists.txt | head -n 1)
if [[ "${SRC_VERSION}" != "${VERSION}" ]]; then
  echo "WARNING: Build version and source version are not the same"
  echo "WARNING:    Build Version: ${VERSION}"
  echo "WARNING:   Source Version: ${SRC_VERSION}"
fi

echo "INFO: configure release tree with CMake..."
cmake -G Ninja -S . -B build -DSPINE_BUILD_MAIN=ON >/dev/null || {
  echo "ERROR: Unable to configure release tree with CMake"
  exit 1
}

cd "${TMP_DIR}" || exit 1

echo "INFO: Packaging..."
tar -zcf "cacti-spine-${VERSION}.tar.gz" "cacti-spine-${VERSION}" || {
  echo "ERROR: Unable to package"
  exit 1
}

popd >/dev/null || exit 1

echo "INFO: Cleaning up build directory..."
rm -rf "${TMP_DIR}/cacti-spine-${VERSION}" >/dev/null 2>&1

echo "INFO: Completed..."
echo ""
echo "Package file: ${TMP_DIR}/cacti-spine-${VERSION}.tar.gz"
echo ""
